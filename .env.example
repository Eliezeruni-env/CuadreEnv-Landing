# Puerto de la API de leads
API_PORT=8787

# Token para que el USM consulte/actualice los leads.
# GET /api/leads, GET /api/leads/stats y PATCH /api/leads/:id requieren:
#   Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=cambia-este-token-super-secreto

# Orígenes permitidos para CORS (separados por coma). Incluye el USM.
CORS_ORIGINS=http://localhost:5173,http://localhost:5180

# Ruta del archivo SQLite
DB_PATH=./data/leads.db
